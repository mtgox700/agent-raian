# ============================================================================
#  Phantera — .env.local template
#  Copy this file to `.env.local` (in apps/web) and paste your keys.
#  Then run:  npm run setup:check   (prints what's active vs blocked)
#
#  Variables are grouped by PRIORITY. Fill tier 1 first — the app won't boot
#  without it. Everything below degrades gracefully (mocks / skipped) when empty.
#  Free-tier is enough to start every tier.
# ============================================================================


# ── TIER 1 · CORE (required to run the app at all) ──────────────────────────

# Postgres — Neon free-tier recommended (neon.tech). Use the POOLED url for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Clerk auth — dashboard.clerk.com → API keys. REQUIRED to render the dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."          # Clerk → Webhooks (user lifecycle → DB)

# Clerk routing (defaults are fine)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NODE_ENV="development"

# Secrets-at-rest (OAuth tokens / SMTP passwords). Generate: openssl rand -hex 32
ENCRYPTION_KEY=""                          # 64-char hex (32 bytes)



# ── TIER 2 · CLAUDE ANTHROPIC (production-default LLM provider) ─────────────
# Quality > Ollama for nuanced copywriting & multilingual (especially FR).
# When this key is set, ALL agents route to Claude:
#   classify → claude-haiku-4-5-20251001  (cheap reply classification)
#   score    → claude-haiku-4-5-20251001  (lead scoring)
#   copy     → claude-sonnet-4-6           (email copywriting)
# Get a key: console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=""
# Optional global override (applies to all tasks). Leave empty for per-task routing.
ANTHROPIC_MODEL=""

# ── TIER 2 · LLM (AI agents: scoring / copy / classification) ───────────────
# Ollama Cloud (ollama.com) — OpenAI-compatible. Set the API key to enable live
# calls; empty → deterministic mocks (tests stay green).
OLLAMA_BASE_URL="https://ollama.com/v1"
OLLAMA_API_KEY=""
OLLAMA_MODEL="qwen3.5"                      # latest cloud models: qwen3.5, deepseek-v4-pro, glm-5.1, gpt-oss…
OLLAMA_MODEL_CLASSIFY="qwen3.5"            # optional per-task routing
OLLAMA_MODEL_SCORE="qwen3.5"
OLLAMA_MODEL_COPY="deepseek-v4-pro"


# ── TIER 3 · EMAIL SENDING (campaigns + transactional) ──────────────────────
RESEND_API_KEY=""                          # resend.com — transactional/reply side
RESEND_WEBHOOK_SECRET=""                   # Resend → Webhooks (open/click/bounce)
RESEND_FROM_EMAIL="Phantera <outreach@phantera-tn.com>"
INBOUND_WEBHOOK_SECRET=""                  # shared secret for the Cloudflare inbound-email worker


# ── TIER 4 · DURABLE EXECUTION + SCALE (Inngest, Upstash) ───────────────────
# Inngest — durable sequences/SDR. Dev: `npx inngest-cli@latest dev` (no keys).
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Upstash Redis (REST) — cross-instance idempotency + rate-limit. upstash.com free-tier.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# ── TIER 5 · DATA / ENRICHMENT (lead quality — waterfall) ───────────────────
APOLLO_API_KEY=""                          # sourcing + firmographics
HUNTER_API_KEY=""                          # email finder/verify
PROSPEO_API_KEY=""                         # waterfall filler (pay-on-success)
FINDYMAIL_API_KEY=""
LEADMAGIC_API_KEY=""
# EU GDPR anchors (adapters wired next): DROPCONTACT_API_KEY="", COGNISM_API_KEY=""


# ── TIER 6 · MULTICHANNEL (LinkedIn + email + WhatsApp) ─────────────────────
UNIPILE_DSN=""                             # e.g. https://api1.unipile.com:13111
UNIPILE_API_KEY=""


# ── TIER 7 · BILLING (Stripe) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_PRO_ANNUAL_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
STRIPE_BUSINESS_ANNUAL_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=""
STRIPE_ACTIVE_CONTACTS_METER="active_contacts"   # usage-based metering


# ── TIER 8 · OPS / CRON / SECURITY ──────────────────────────────────────────
CRON_SECRET=""                             # bearer for /api/cron/* (openssl rand -hex 32)
# LLM red-team (garak). ENABLE only for a scan; never in public prod.
ENABLE_REDTEAM=""                          # "1" to expose /api/security/redteam
REDTEAM_SECRET=""                          # optional extra gate
RUN_LLM_EVALS=""                           # "1" to run model-gated eval tests in CI


# ── TIER 9 · OBSERVABILITY (optional, fire-and-forget) ──────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"


# ── TIER 2-BIS · MAILBOX OAUTH (send from user's Gmail/Outlook) ─────────────
# Required for "Connecter Gmail" / "Connecter Outlook" in Settings.
# Without these, users can only use SMTP custom or fallback to Resend (Phantera domain).

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
# Scopes: gmail.send, gmail.readonly, gmail.modify, userinfo.email, userinfo.profile
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://phantera-tn.com/api/auth/gmail/callback"

# Microsoft OAuth — portal.azure.com → App registrations
# Scopes: Mail.Send, Mail.ReadWrite, User.Read, offline_access
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="https://phantera-tn.com/api/auth/outlook/callback"

# Domain used as Reply-To for fallback (Cloudflare Worker captures these)
REPLY_TO_DOMAIN="phantera-tn.com"
SENDING_DOMAIN="phantera-tn.com"
