{
  "name": "@phantera/contract",
  "version": "0.1.0",
  "private": true,
  "description": "API contract between the Phantera back (chassis) and its fronts (bodies). Source of truth for openapi.json and the SDK.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi": "./src/openapi.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "openapi": "tsx scripts/build-openapi.ts",
    "openapi:check": "tsx scripts/build-openapi.ts --check"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
