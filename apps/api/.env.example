# ─── Database (Railway PostgreSQL) ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# ─── Clerk Routing ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NODE_ENV="development"

# ─── Inngest (durable execution) ─────────────────────────────────────────────
# Dev: run `npx inngest-cli@latest dev` — no keys needed.
# Prod: connect the Inngest Vercel integration, or set these from the dashboard.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── LLM (Ollama Cloud, OpenAI-compatible) ───────────────────────────────────
# Default targets Ollama Cloud. For self-hosting set OLLAMA_BASE_URL to a local
# Ollama (http://localhost:11434/v1). Set OLLAMA_API_KEY (your Ollama Cloud key)
# to enable live calls — agents fall back to deterministic mocks when it's empty.
OLLAMA_BASE_URL="https://ollama.com/v1"
OLLAMA_API_KEY=""
# Latest Ollama Cloud models (June 2026): qwen3.5, deepseek-v4-pro, glm-5.1,
# kimi-k2.6, minimax-m3, gpt-oss, deepseek-v4-flash …
OLLAMA_MODEL="qwen3.5"
# Optional per-task routing (fall back to OLLAMA_MODEL):
OLLAMA_MODEL_CLASSIFY="qwen3.5"
OLLAMA_MODEL_SCORE="qwen3.5"
OLLAMA_MODEL_COPY="deepseek-v4-pro"
LANGSMITH_API_KEY=""

# ─── Analyste de campagnes (Anthropic) ──────────────────────────────────────
# Paid answers only with both: the key and ANALYST_LIVE=1 (founder's go,
# after the eval and the budget). Without them the screen says "not yet".
ANTHROPIC_API_KEY=""
ANALYST_LIVE="0"
# Local only: scripted answers, no model, no cost (never on Vercel nor in a prod build).
ANALYST_SANDBOX_MODEL="0"

# ─── Data Enrichment (Phase 2+) ──────────────────────────────────────────────
APOLLO_API_KEY=""
# Phone lookups (8 Apollo credits per mobile found). 0 or empty = disabled.
APOLLO_PHONE_REVEALS_PER_MONTH="0"
# Per workspace and per month (default 25).
APOLLO_PHONE_REVEALS_PER_WORKSPACE_MONTH="25"
HUNTER_API_KEY=""
CLEARBIT_API_KEY=""
# Waterfall providers (pay-on-success) — any subset; the waterfall skips unset ones.
PROSPEO_API_KEY=""
FINDYMAIL_API_KEY=""
LEADMAGIC_API_KEY=""
# EU GDPR anchor — Dropcontact leads the waterfall when set (async batch+poll,
# DROPCONTACT_MAX_WAIT_MS tunable, default 30000). Cognism adapter: next.
DROPCONTACT_API_KEY=""

# ─── Multichannel (Unipile: LinkedIn + email + WhatsApp) ─────────────────────
UNIPILE_DSN=""
UNIPILE_API_KEY=""
PROXYCURL_API_KEY=""
APIFY_API_KEY=""

# ─── Vector DB (Phase 2+) ────────────────────────────────────────────────────
PINECONE_API_KEY=""
PINECONE_INDEX_NAME=""
TINYBIRD_API_KEY=""

# ─── Sender Identity — Encryption ───────────────────────────────────────────
# REQUIRED — 64-char hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this key requires re-encrypting all stored tokens (run migration script).
ENCRYPTION_KEY=""

# ─── Google OAuth (Gmail sender) ─────────────────────────────────────────────
# Create at console.cloud.google.com → APIs & Services → OAuth 2.0 Client IDs
# Authorized redirect URI: https://your-domain.com/api/auth/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://phantera-tn.com/api/auth/gmail/callback"

# ─── Microsoft OAuth (Outlook sender) ────────────────────────────────────────
# Create at portal.azure.com → App registrations → New registration
# Redirect URI: https://your-domain.com/api/auth/outlook/callback
# Required API permissions: Mail.Send, Mail.ReadWrite, User.Read, offline_access
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="https://phantera-tn.com/api/auth/outlook/callback"

# ─── Inbound replies (Cloudflare Worker — fallback for SMTP users) ────────────
INBOUND_WEBHOOK_SECRET=""
REPLY_TO_DOMAIN="phantera-tn.com"
SENDING_DOMAIN="phantera-tn.com"

# ─── Email Sending (Resend — fallback when no mailbox connected) ──────────────
RESEND_API_KEY=""                          # Get from resend.com → API Keys
RESEND_WEBHOOK_SECRET=""                  # Get from resend.com → Webhooks (after adding endpoint)
RESEND_FROM_EMAIL="noreply@phantera.app"  # Your verified sender domain
MAILREACH_API_KEY=""

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Create these price IDs in your Stripe Dashboard → Products → Prices.
# 3 plans × 2 billing cycles = 6 price IDs total.
# Annual prices are billed yearly with ~20% discount vs monthly × 12.
STRIPE_PRO_PRICE_ID="price_..."                # Monthly  €49
STRIPE_PRO_ANNUAL_PRICE_ID="price_..."         # Yearly   €470  (49 × 12 × 0.80)
STRIPE_BUSINESS_PRICE_ID="price_..."           # Monthly  €149
STRIPE_BUSINESS_ANNUAL_PRICE_ID="price_..."    # Yearly   €1430 (149 × 12 × 0.80)
STRIPE_ENTERPRISE_PRICE_ID="price_..."         # Monthly  €500
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID="price_..."  # Yearly   €4800 (500 × 12 × 0.80)

# ─── Analytics (PostHog) ─────────────────────────────────────────────────────
# Get from posthog.com → Settings → Project token (starts with phc_)
# Same token goes in all 4 variables; the NEXT_PUBLIC_* ones expose to the browser.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
POSTHOG_API_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"

# ─── Monitoring (Sentry) ─────────────────────────────────────────────────────
# Get from sentry.io → Project Settings → Client keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Optional — source-map upload at build time
# Get auth token: sentry.io → Settings → Auth Tokens → New (scopes: project:releases)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
