{
  "$schema": "../theme.schema.json",
  "key": "phantera",
  "name": "Phantera",
  "default": true,
  "mode": "dark",
  "domains": [
    "phantera-tn.com",
    "www.phantera-tn.com"
  ],
  "colors": {
    "primary": "#00D4FF",
    "primaryDeep": "#0099CC",
    "background": "#050508",
    "surface": "#0A0A14",
    "text": "#FFFFFF",
    "textMuted": "#8888A0"
  },
  "auth": {
    "background": "#0B0D13",
    "inputBackground": "#050508",
    "inputText": "#F4F4F6",
    "text": "#F4F4F6",
    "textSecondary": "#8E94A6",
    "danger": "#ef4444",
    "radius": "0.375rem"
  },
  "vars": {
    "site": {
      "--brand-primary": "#00d4ff",
      "--brand-primary-deep": "#0077a8",
      "--brand-primary-rgb": "0, 212, 255",
      "--brand-primary-deep-rgb": "0, 119, 168",
      "--bg-base": "#050508",
      "--text-base": "#f4f4f6",
      "--fg-rgb": "244, 244, 246",
      "--surface-glass-rgb": "11, 13, 19",
      "--bg-base-rgb": "5, 5, 8",
      "--scroll-thumb": "#1e2330",
      "--ease-signal": "cubic-bezier(0.2, 0.7, 0.1, 1)",
      "--gold": "#f0b429",
      "--gold-deep": "#d4960a",
      "--gold-rgb": "240, 180, 41",
      "--ai": "#7c3aed",
      "--ai-rgb": "124, 58, 237",
      "--brand-bright": "#00e5ff",
      "--brand-mid": "#00c8f0",
      "--brand-pressed": "#0099cc",
      "--brand-glow-rgb": "0, 229, 255",
      "--highlight": "#ec4899",
      "--success": "#10b981",
      "--success-deep": "#059669",
      "--success-fg": "#22c55e",
      "--watermark-alpha": "0.022",
      "--auth-card-shadow": "0 0 0 1px rgba(var(--brand-primary-rgb), 0.08), 0 32px 64px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(var(--fg-rgb), 0.04)",
      "--c-white": "244 244 246",
      "--c-void": "5 5 8",
      "--c-obsidian": "11 13 19",
      "--c-surface": "17 20 28",
      "--c-surface2": "23 27 37",
      "--c-muted": "142 148 166",
      "--c-border": "30 35 48",
      "--c-cyan-300": "0 255 255",
      "--c-cyan": "0 212 255",
      "--c-cyan-500": "0 170 255",
      "--c-cyan-600": "0 153 204",
      "--c-cyan-700": "0 119 168",
      "--c-gold": "240 180 41",
      "--c-gold-500": "251 188 5",
      "--c-success": "16 185 129",
      "--c-success-fg": "34 197 94",
      "--c-success-deep": "5 150 105",
      "--c-warning": "249 115 22",
      "--c-danger": "239 68 68",
      "--c-ai": "124 58 237",
      "--c-ai-fg": "167 139 250",
      "--c-highlight": "236 72 153"
    }
  }
}
