{
  "name": "@phantera/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && node scripts/migrate-on-deploy.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=999",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:llm:security": "bash security/garak/run_audit.sh",
    "eval:analyst": "npx tsx --env-file=.env.local scripts/eval-analyst.ts",
    "setup:check": "node scripts/check-env.mjs",
    "db:bootstrap": "node scripts/db-bootstrap.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@clerk/localizations": "^3.37.9",
    "@clerk/nextjs": "^6.39.2",
    "@phantera/content": "*",
    "@phantera/contract": "*",
    "@phantera/themes": "*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.76.2",
    "@types/mailparser": "^3.9.0",
    "@types/pg": "^8.23.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fflate": "0.8.3",
    "inngest": "^4.24.0",
    "mailparser": "^3.9.39",
    "next": "^16.4.2",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "posthog-node": "^5.56.1",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.8.0",
    "stripe": "^22.0.1",
    "svix": "^1.90.0",
    "zod": "^4.6.7"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.14.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.2"
  },
  "description": "The chassis: API routes, business logic, database, durable jobs. No pages."
}
